# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# Optional overrides
# EMPORIO_MODEL=claude-haiku-5-5
# EMPORIO_EFFORT=medium

# Optional: when Claude is overloaded/rate-limited, answer that turn with the next provider in this chain.
# Requires pip install -e ".[free]" and that provider's key below.
# EMPORIO_FALLBACK_MODEL=gemini:gemini-3.1-flash-lite,groq:openai/gpt-oss-20b   # tried in order

# Optional: free providers for model comparison (pip install -e ".[free]").
# Select one with EMPORIO_MODEL=<provider>:<model>, e.g. gemini:gemini-3.5-flash
# GEMINI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
